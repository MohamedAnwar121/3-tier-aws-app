[Unit]
Description=Backend Application (FastAPI/Uvicorn)
After=network.target vault-agent.service

[Service]
User=ec2-user
WorkingDirectory=/opt/backend
EnvironmentFile=/etc/backend/db.env
ExecStart=/usr/local/bin/uvicorn main:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
