vault {
  address = "{{ vault_address | default(lookup('env', 'VAULT_ADDR')) }}"
}

# Use AWS IAM auth — instance role is automatically picked up
auto_auth {
  method "aws" {
    mount_path = "auth/aws"
    config = {
      type = "iam"
      role = "{{ project }}-{{ environment }}-ec2"
    }
  }

  sink "file" {
    config = {
      path = "/run/vault-agent/token"
      mode = 0640
    }
  }
}

# Write DB credentials to a file the app can read
template {
  destination = "/etc/app/db.env"
  contents    = <<EOT
{{ '{{' }}- with secret "secret/{{ environment }}/database" -{{ '}}' }}
DB_HOST={{ '{{' }} .Data.data.host {{ '}}' }}
DB_PORT={{ '{{' }} .Data.data.port {{ '}}' }}
DB_NAME={{ '{{' }} .Data.data.dbname {{ '}}' }}
DB_USER={{ '{{' }} .Data.data.username {{ '}}' }}
DB_PASS={{ '{{' }} .Data.data.password {{ '}}' }}
{{ '{{' }}- end -{{ '}}' }}
EOT
}
