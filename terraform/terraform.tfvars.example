project       = "myapp"
environment   = "prod"
aws_region    = "us-east-1"
vault_address = "https://vault.example.com:8200"

# Get current Amazon Linux 2 AMI from AWS console for your region
ami_id        = "ami-0c02fb55956c7d316"
key_name      = "my-keypair"
instance_type = "t3.micro"

azs = ["us-east-1a", "us-east-1b"]

frontend_min = 2
frontend_max = 4
backend_min  = 2
backend_max  = 4

db_name           = "appdb"
db_username       = "dbadmin"
db_instance_class = "db.t3.micro"
